{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:praenora:schema:run-record:0.1",
  "title": "Praenora run record",
  "description": "What a run used (the hashed reproducibility section) and how it went (execution).",
  "type": "object",
  "required": [
    "kind",
    "format_version",
    "fingerprint",
    "reproducibility",
    "execution"
  ],
  "properties": {
    "kind": {
      "const": "run-record"
    },
    "format_version": {
      "$ref": "#/definitions/semver"
    },
    "fingerprint": {
      "$ref": "#/definitions/fingerprint"
    },
    "reproducibility": {
      "type": "object",
      "required": [
        "versions",
        "workflow",
        "catalog",
        "time",
        "seed",
        "ticks",
        "timeouts",
        "inputs",
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "versions": {
          "type": "object",
          "required": [
            "runtime",
            "abi",
            "pmp"
          ],
          "additionalProperties": false,
          "properties": {
            "runtime": {
              "$ref": "#/definitions/semver"
            },
            "abi": {
              "type": "object",
              "required": [
                "major",
                "minor"
              ],
              "additionalProperties": false,
              "properties": {
                "major": {
                  "type": "integer",
                  "minimum": 0
                },
                "minor": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "pmp": {
              "$ref": "#/definitions/semver"
            }
          }
        },
        "workflow": {
          "type": "object",
          "required": [
            "name",
            "version",
            "digest"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "$ref": "#/definitions/catalog_id"
            },
            "version": {
              "$ref": "#/definitions/semver"
            },
            "digest": {
              "$ref": "#/definitions/sha256"
            }
          }
        },
        "catalog": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/sha256"
          },
          "description": "Digest of every catalog entry used, by id@version."
        },
        "time": {
          "$ref": "#/definitions/time_base"
        },
        "seed": {
          "$ref": "#/definitions/seed"
        },
        "ticks": {
          "anyOf": [
            {
              "$ref": "#/definitions/count"
            },
            {
              "type": "null"
            }
          ],
          "description": "The run's tick count; null when the run lasts until its replay inputs are exhausted."
        },
        "timeouts": {
          "$ref": "#/definitions/timeouts"
        },
        "inputs": {
          "type": "object",
          "patternProperties": {
            "^(?!(inputs|outputs)$)[a-z][a-z0-9_]*$": {
              "type": "object",
              "required": [
                "source",
                "digest"
              ],
              "additionalProperties": false,
              "properties": {
                "source": {
                  "enum": [
                    "observation-csv",
                    "json-document"
                  ]
                },
                "digest": {
                  "$ref": "#/definitions/sha256"
                },
                "columns": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "additionalProperties": false
        },
        "steps": {
          "type": "object",
          "patternProperties": {
            "^(?!(inputs|outputs)$)[a-z][a-z0-9_]*$": {
              "type": "object",
              "required": [
                "capability",
                "module",
                "parameters",
                "seed"
              ],
              "additionalProperties": false,
              "properties": {
                "capability": {
                  "$ref": "#/definitions/capability_ref"
                },
                "module": {
                  "type": "object",
                  "required": [
                    "name",
                    "version",
                    "manifest_sha256",
                    "library_sha256",
                    "sdk_version"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "$ref": "#/definitions/module_name"
                    },
                    "version": {
                      "$ref": "#/definitions/semver"
                    },
                    "manifest_sha256": {
                      "$ref": "#/definitions/sha256"
                    },
                    "library_sha256": {
                      "$ref": "#/definitions/sha256"
                    },
                    "sdk_version": {
                      "$ref": "#/definitions/semver"
                    }
                  }
                },
                "parameters": {
                  "type": "object"
                },
                "seed": {
                  "$ref": "#/definitions/seed"
                },
                "timeouts": {
                  "$ref": "#/definitions/timeouts"
                }
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "status",
        "ticks_completed",
        "platform",
        "overrides",
        "validation"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "running",
            "completed",
            "stopped",
            "failed"
          ],
          "description": "The run's status: running from its start, then how it ended."
        },
        "started_at": {
          "anyOf": [
            {
              "$ref": "#/definitions/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "finished_at": {
          "anyOf": [
            {
              "$ref": "#/definitions/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "final_status": {
          "type": "object",
          "description": "The final status snapshot (a status-snapshot document), written when the run ends."
        },
        "ticks_completed": {
          "$ref": "#/definitions/count"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/definitions/error_record"
            },
            {
              "type": "null"
            }
          ]
        },
        "platform": {
          "type": "object",
          "required": [
            "os",
            "arch",
            "compiler",
            "build_type"
          ],
          "additionalProperties": false,
          "properties": {
            "os": {
              "type": "string"
            },
            "arch": {
              "type": "string"
            },
            "compiler": {
              "type": "string"
            },
            "build_type": {
              "type": "string"
            }
          }
        },
        "overrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "seed": {
              "$ref": "#/definitions/seed"
            },
            "ticks": {
              "$ref": "#/definitions/count"
            }
          },
          "description": "The run settings the caller overrode (CLI flags or API options); empty when none."
        },
        "validation": {
          "enum": [
            "strict",
            "off"
          ],
          "description": "Whether payloads were validated against their message types (strict) or not (off, for performance measurements)."
        },
        "outputs": {
          "type": "object",
          "patternProperties": {
            "^(?!(inputs|outputs)$)[a-z][a-z0-9_]*$": {
              "type": "object",
              "required": [
                "file",
                "sha256",
                "messages"
              ],
              "additionalProperties": false,
              "properties": {
                "file": {
                  "type": "string"
                },
                "sha256": {
                  "$ref": "#/definitions/sha256"
                },
                "messages": {
                  "$ref": "#/definitions/count"
                }
              }
            }
          },
          "additionalProperties": false
        },
        "trace": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string"
            },
            "sha256": {
              "$ref": "#/definitions/sha256"
            },
            "messages": {
              "$ref": "#/definitions/count"
            }
          }
        }
      }
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "definitions": {
    "capability_ref": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/catalog_id"
        },
        "version": {
          "$ref": "#/definitions/semver"
        }
      }
    },
    "catalog_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "duration": {
      "$comment": "A duration is either a string <number><unit> with unit ns, us, ms, s, m or h (\"30s\", \"1.5m\"; \"0\" or \"none\" disables the timeout), or the integer 0, which also disables it. The pattern applies only to strings and minimum/maximum only to numbers, so every other number is rejected.",
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^(none|0|[0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))$",
      "minimum": 0,
      "maximum": 0,
      "description": "<number><unit> with unit ns|us|ms|s|m|h; 0 or none disables."
    },
    "error_record": {
      "type": "object",
      "required": [
        "code",
        "name",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "integer"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": {
          "type": "string"
        },
        "tick": {
          "anyOf": [
            {
              "$ref": "#/definitions/count"
            },
            {
              "type": "null"
            }
          ]
        },
        "at": {
          "anyOf": [
            {
              "$ref": "#/definitions/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "cause": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "module_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "time_base": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": {
          "type": "string",
          "minLength": 1,
          "default": "1"
        },
        "start": {
          "type": "number",
          "default": 0.0
        },
        "period": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1.0
        }
      }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "invoke": {
          "$ref": "#/definitions/duration"
        },
        "lifecycle": {
          "$ref": "#/definitions/duration"
        },
        "cancel_grace": {
          "$ref": "#/definitions/duration"
        }
      }
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{9}Z$",
      "description": "RFC 3339 UTC time with exactly 9 fractional digits."
    }
  }
}
