{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:praenora:schema:pmp-result:0.1",
  "title": "PMP result document",
  "description": "What invoke() returns: the data of each output port, and optional diagnostics.",
  "type": "object",
  "required": [
    "outputs"
  ],
  "properties": {
    "pmp_version": {
      "$ref": "#/definitions/semver"
    },
    "outputs": {
      "type": "object",
      "patternProperties": {
        "^(?!(inputs|outputs)$)[a-z][a-z0-9_]*$": {
          "type": "object",
          "required": [
            "data"
          ],
          "additionalProperties": false,
          "properties": {
            "data": {}
          }
        }
      },
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "object"
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "definitions": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    }
  }
}
