{
  "version": 5,
  "configurePresets": [
    {
      "name": "dev-local",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "/path/to/dependency/prefix;/path/to/another/prefix",
        "Python3_EXECUTABLE": "/path/to/python3",
        "PRAENORA_BUILD_PYTHON": "ON",
        "PRAENORA_FETCH_DEPENDENCIES": "OFF"
      }
    },
    {
      "name": "dev",
      "displayName": "Local development, Debug",
      "inherits": ["macos-arm64-debug", "dev-local"]
    },
    {
      "name": "dev-release",
      "displayName": "Local development, Release",
      "inherits": ["macos-arm64-release", "dev-local"]
    },
    {
      "name": "dev-asan",
      "displayName": "Local development, AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": ["macos-arm64-asan", "dev-local"]
    },
    {
      "name": "dev-tsan",
      "displayName": "Local development, ThreadSanitizer",
      "inherits": ["macos-arm64-tsan", "dev-local"]
    },
    {
      "name": "dev-antimony-local",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "/path/to/dependency/prefix;/path/to/roadrunner/prefix;/path/to/roadrunner/prefix/lib/cmake;/path/to/antimony/prefix",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0",
        "PRAENORA_WITH_ANTIMONY": "ON"
      }
    },
    {
      "name": "dev-engines-local",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "/path/to/dependency/prefix;/path/to/roadrunner/prefix;/path/to/roadrunner/prefix/lib/cmake;/path/to/roadrunner/prefix/lib/cmake/Poco;/path/to/llvm/prefix;/path/to/antimony/prefix",
        "LLVM_INSTALL_PREFIX": "/path/to/llvm/prefix",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0",
        "PRAENORA_WITH_ROADRUNNER": "ON",
        "PRAENORA_WITH_ANTIMONY": "ON"
      }
    },
    {
      "name": "dev-antimony",
      "displayName": "Local development with the antimony provider, Debug",
      "inherits": ["macos-arm64-debug", "dev-antimony-local", "dev-local"]
    },
    {
      "name": "dev-antimony-tsan",
      "displayName": "Local development with the antimony provider, ThreadSanitizer",
      "inherits": ["macos-arm64-tsan", "dev-antimony-local", "dev-local"]
    },
    {
      "name": "dev-engines",
      "displayName": "Local development with the roadrunner and antimony providers, Debug",
      "inherits": ["macos-arm64-debug", "dev-engines-local", "dev-local"]
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "inherits": "macos-arm64-debug",
      "configurePreset": "dev"
    },
    {
      "name": "dev-release",
      "inherits": "macos-arm64-release",
      "configurePreset": "dev-release"
    },
    {
      "name": "dev-asan",
      "inherits": "macos-arm64-asan",
      "configurePreset": "dev-asan"
    },
    {
      "name": "dev-tsan",
      "inherits": "macos-arm64-tsan",
      "configurePreset": "dev-tsan"
    },
    {
      "name": "dev-antimony",
      "inherits": "macos-arm64-debug",
      "configurePreset": "dev-antimony"
    },
    {
      "name": "dev-antimony-tsan",
      "inherits": "macos-arm64-tsan",
      "configurePreset": "dev-antimony-tsan"
    },
    {
      "name": "dev-engines",
      "inherits": "macos-arm64-debug",
      "configurePreset": "dev-engines"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "inherits": "macos-arm64-debug",
      "configurePreset": "dev"
    },
    {
      "name": "dev-release",
      "inherits": "macos-arm64-release",
      "configurePreset": "dev-release"
    },
    {
      "name": "dev-asan",
      "inherits": "macos-arm64-asan",
      "configurePreset": "dev-asan"
    },
    {
      "name": "dev-tsan",
      "inherits": "macos-arm64-tsan",
      "configurePreset": "dev-tsan"
    },
    {
      "name": "dev-antimony",
      "inherits": "macos-arm64-debug",
      "configurePreset": "dev-antimony"
    },
    {
      "name": "dev-antimony-tsan",
      "inherits": "macos-arm64-tsan",
      "configurePreset": "dev-antimony-tsan"
    },
    {
      "name": "dev-engines",
      "inherits": "macos-arm64-debug",
      "configurePreset": "dev-engines"
    }
  ]
}
