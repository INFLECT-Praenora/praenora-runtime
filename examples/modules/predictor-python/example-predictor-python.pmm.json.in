{
  "kind": "module-manifest",
  "format_version": "@PRAENORA_MODULE_MANIFEST_FORMAT_VERSION@",
  "module": {
    "name": "@PRAENORA_MODULE_NAME@",
    "version": "@PRAENORA_MODULE_VERSION@",
    "summary": "Predicts forward from each estimate with the logistic equation, in Python.",
    "authors": ["Praenora maintainers"],
    "repository": "https://github.com/INFLECT-Praenora/praenora-runtime"
  },
  "abi": { "major": @PRAENORA_ABI_MAJOR@, "minor": @PRAENORA_ABI_MINOR@ },
  "pmp_version": "@PRAENORA_PMP_VERSION@",
  "sdk_version": "@PRAENORA_SDK_VERSION@",
  "library": { "path": "@PRAENORA_MODULE_LIBRARY_FILE@" },
  "platform": { "os": "@PRAENORA_MODULE_OS@", "arch": "@PRAENORA_MODULE_ARCH@" },
  "capabilities": @PRAENORA_MODULE_CAPABILITIES_JSON@,
  "requires": @PRAENORA_MODULE_REQUIRES_JSON@,
  "parameters_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "growth_rate": { "type": "number", "exclusiveMinimum": 0, "default": 0.3 },
      "capacity": { "type": "number", "exclusiveMinimum": 0, "default": 100.0 },
      "horizon": { "type": "number", "exclusiveMinimum": 0, "default": 4.0 },
      "step_size": { "type": "number", "exclusiveMinimum": 0, "default": 0.05 },
      "output_interval": { "type": "number", "exclusiveMinimum": 0, "default": 0.5 }
    },
    "additionalProperties": false
  },
  "features": {
    "concurrency": "instance",
    "cancellation": false,
    "diagnostics": true,
    "self_test": false
  },
  "tests": { "vectors": "@PRAENORA_MODULE_TEST_VECTORS@" }
}
