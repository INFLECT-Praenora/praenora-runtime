# Build-time part of praenora_embed_resources() (PraenoraEmbedResources.cmake). Writes
# <name>_resources.hpp and <name>_resources.cpp: one unsigned char array per file plus an index
# sorted by resource path.
#
# Run as: cmake -DPRAENORA_EMBED_NAME=<name> -DPRAENORA_EMBED_LIST=<list.cmake>
#               -DPRAENORA_EMBED_CPP=<out.cpp> -DPRAENORA_EMBED_HPP=<out.hpp> -P praenora_embed.cmake
# The list script sets PRAENORA_EMBED_BASE_DIR and PRAENORA_EMBED_FILES (absolute paths).

cmake_minimum_required(VERSION 3.24)

foreach(variable IN ITEMS PRAENORA_EMBED_NAME PRAENORA_EMBED_LIST PRAENORA_EMBED_CPP
                          PRAENORA_EMBED_HPP)
    if(NOT DEFINED ${variable})
        message(FATAL_ERROR "praenora_embed.cmake: ${variable} is not set")
    endif()
endforeach()
include("${PRAENORA_EMBED_LIST}")

set(name "${PRAENORA_EMBED_NAME}")
string(TOUPPER "${name}" guard)
set(guard "${guard}_RESOURCES_HPP")

# Sorted by resource path, the order the index is searched in.
set(paths "")
foreach(file IN LISTS PRAENORA_EMBED_FILES)
    file(RELATIVE_PATH relative "${PRAENORA_EMBED_BASE_DIR}" "${file}")
    list(APPEND paths "${relative}")
endforeach()
list(SORT paths)
list(LENGTH paths count)

set(hpp "// Generated by praenora_embed_resources(); do not edit.
#ifndef ${guard}
#define ${guard}

#include <optional>
#include <string>
#include <string_view>
#include <vector>

// The bytes of the embedded resource at `path` (relative, '/'-separated), if there is one.
std::optional<std::string_view> ${name}_find_resource(std::string_view path);

// The sorted paths of the embedded resources that start with `prefix`.
std::vector<std::string> ${name}_list_resources(std::string_view prefix);

#endif // ${guard}
")

set(cpp "// Generated by praenora_embed_resources() from ${count} file(s); do not edit.
#include \"${name}_resources.hpp\"
")

if(count EQUAL 0)
    string(APPEND cpp "
std::optional<std::string_view> ${name}_find_resource(std::string_view) {
    return std::nullopt;
}

std::vector<std::string> ${name}_list_resources(std::string_view) {
    return {};
}
")
else()
    string(APPEND cpp "
#include <algorithm>
#include <cstddef>
#include <iterator>

namespace {

struct Resource {
    std::string_view path;
    const unsigned char* data;
    std::size_t size;
};
")
    set(index "")
    set(number 0)
    foreach(relative IN LISTS paths)
        file(READ "${PRAENORA_EMBED_BASE_DIR}/${relative}" hex HEX)
        string(LENGTH "${hex}" hex_length)
        math(EXPR size "${hex_length} / 2")
        if(size EQUAL 0)
            set(bytes "0x00,") # C++ arrays cannot be empty; the size stays 0
        else()
            string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
            # Sixteen bytes per line.
            string(REPEAT "0x[0-9a-f][0-9a-f]," 16 row)
            string(REGEX REPLACE "(${row})" "\\1\n    " bytes "${bytes}")
            string(REGEX REPLACE "\n    $" "" bytes "${bytes}")
        endif()
        string(APPEND cpp "
// ${relative}
const unsigned char kResource${number}[] = {
    ${bytes}
};
")
        string(APPEND index "    {\"${relative}\", kResource${number}, ${size}},\n")
        math(EXPR number "${number} + 1")
    endforeach()
    string(APPEND cpp "
// Sorted by path.
const Resource kResources[] = {
${index}};

} // namespace

std::optional<std::string_view> ${name}_find_resource(std::string_view path) {
    const auto end = std::end(kResources);
    const auto it = std::lower_bound(std::begin(kResources), end, path,
                                     [](const Resource& resource, std::string_view wanted) {
                                         return resource.path < wanted;
                                     });
    if (it == end || it->path != path) {
        return std::nullopt;
    }
    return std::string_view(reinterpret_cast<const char*>(it->data), it->size);
}

std::vector<std::string> ${name}_list_resources(std::string_view prefix) {
    std::vector<std::string> paths;
    for (const auto& resource : kResources) {
        if (resource.path.compare(0, prefix.size(), prefix) == 0) {
            paths.emplace_back(resource.path);
        }
    }
    return paths;
}
")
endif()

file(WRITE "${PRAENORA_EMBED_HPP}" "${hpp}")
file(WRITE "${PRAENORA_EMBED_CPP}" "${cpp}")
