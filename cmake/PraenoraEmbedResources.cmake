# praenora_embed_resources(TARGET <target> NAME <name> BASE_DIR <dir> FILES <file>...)
#
# Embeds files into <target> as byte arrays with an index, so the program needs no data files at
# run time. Byte arrays rather than string literals avoid compiler limits on literal length.
#
# Generates ${CMAKE_CURRENT_BINARY_DIR}/<name>_resources.cpp and <name>_resources.hpp, adds both
# to <target> and adds their directory to its private include path. The header declares, in the
# global namespace:
#
#   std::optional<std::string_view> <name>_find_resource(std::string_view path);
#   std::vector<std::string> <name>_list_resources(std::string_view prefix);
#
# A resource's path is its file path relative to BASE_DIR, with '/' separators; the list is sorted.
# Relative FILES are relative to BASE_DIR; every file must lie below it, and its relative path may
# use only the characters A-Z a-z 0-9 . _ - + @ and /. NAME must be a C identifier, so several
# targets (or one target, several times) can embed resources without symbol clashes. The sources
# are regenerated at build time whenever a listed file or the list itself changes. An empty FILES
# list is allowed: the index is then empty.

include_guard(GLOBAL)

set(_PRAENORA_EMBED_SCRIPT "${CMAKE_CURRENT_LIST_DIR}/praenora_embed.cmake")

function(praenora_embed_resources)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "TARGET;NAME;BASE_DIR" "FILES")
    if(arg_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR
            "praenora_embed_resources(): unexpected arguments: ${arg_UNPARSED_ARGUMENTS}")
    endif()
    foreach(keyword IN ITEMS TARGET NAME BASE_DIR)
        if(NOT arg_${keyword})
            message(FATAL_ERROR "praenora_embed_resources(): ${keyword} is required")
        endif()
    endforeach()
    if(NOT TARGET ${arg_TARGET})
        message(FATAL_ERROR "praenora_embed_resources(): ${arg_TARGET} is not a target")
    endif()
    if(NOT arg_NAME MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
        message(FATAL_ERROR
            "praenora_embed_resources(): NAME '${arg_NAME}' is not a C identifier")
    endif()
    get_filename_component(base_dir "${arg_BASE_DIR}" ABSOLUTE)

    # Absolute paths, checked and sorted by their path relative to BASE_DIR.
    set(entries "")
    foreach(file IN LISTS arg_FILES)
        get_filename_component(file "${file}" ABSOLUTE BASE_DIR "${base_dir}")
        file(RELATIVE_PATH relative "${base_dir}" "${file}")
        if(relative MATCHES "^\\.\\./" OR IS_ABSOLUTE "${relative}")
            message(FATAL_ERROR
                "praenora_embed_resources(${arg_NAME}): ${file} is not below ${base_dir}")
        endif()
        if(NOT relative MATCHES "^[A-Za-z0-9._+@/-]+$")
            message(FATAL_ERROR "praenora_embed_resources(${arg_NAME}): the resource path "
                "'${relative}' may use only A-Z a-z 0-9 . _ - + @ and /")
        endif()
        list(APPEND entries "${relative}|${file}")
    endforeach()
    list(SORT entries)
    list(REMOVE_DUPLICATES entries)

    set(out_dir "${CMAKE_CURRENT_BINARY_DIR}")
    set(cpp "${out_dir}/${arg_NAME}_resources.cpp")
    set(hpp "${out_dir}/${arg_NAME}_resources.hpp")
    set(list_file "${out_dir}/${arg_NAME}_resources.cmake")

    # The list is a CMake script read by praenora_embed.cmake. It is rewritten only when its content
    # changes, so an unchanged list never triggers regeneration.
    set(content "# Generated by praenora_embed_resources(); do not edit.\n")
    string(APPEND content "set(PRAENORA_EMBED_BASE_DIR [==[${base_dir}]==])\n")
    string(APPEND content "set(PRAENORA_EMBED_FILES\n")
    set(files "")
    foreach(entry IN LISTS entries)
        string(FIND "${entry}" "|" bar)
        math(EXPR start "${bar} + 1")
        string(SUBSTRING "${entry}" ${start} -1 file)
        list(APPEND files "${file}")
        string(APPEND content "    [==[${file}]==]\n")
    endforeach()
    string(APPEND content ")\n")
    set(previous "")
    if(EXISTS "${list_file}")
        file(READ "${list_file}" previous)
    endif()
    if(NOT previous STREQUAL content)
        file(WRITE "${list_file}" "${content}")
    endif()

    list(LENGTH files count)
    add_custom_command(
        OUTPUT "${cpp}" "${hpp}"
        COMMAND "${CMAKE_COMMAND}"
            "-DPRAENORA_EMBED_NAME=${arg_NAME}"
            "-DPRAENORA_EMBED_LIST=${list_file}"
            "-DPRAENORA_EMBED_CPP=${cpp}"
            "-DPRAENORA_EMBED_HPP=${hpp}"
            -P "${_PRAENORA_EMBED_SCRIPT}"
        DEPENDS ${files} "${list_file}" "${_PRAENORA_EMBED_SCRIPT}"
        COMMENT "Embedding ${count} resource file(s) as ${arg_NAME}_resources.cpp"
        VERBATIM)
    target_sources(${arg_TARGET} PRIVATE "${cpp}" "${hpp}")
    target_include_directories(${arg_TARGET} PRIVATE "${out_dir}")
endfunction()
