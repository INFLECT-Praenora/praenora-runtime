{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan",
      "hidden": true,
      "cacheVariables": {
        "PRAENORA_SANITIZERS": "address;undefined"
      }
    },
    {
      "name": "tsan",
      "hidden": true,
      "cacheVariables": {
        "PRAENORA_SANITIZERS": "thread"
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": null
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "ci",
      "hidden": true,
      "cacheVariables": {
        "PRAENORA_RUNTIME_DEPS": "$env{PRAENORA_RUNTIME_DEPS}",
        "CMAKE_PREFIX_PATH": "$env{PRAENORA_RUNTIME_DEPS}/json-schema-validator;$env{PRAENORA_RUNTIME_DEPS}/roadrunner;$env{PRAENORA_RUNTIME_DEPS}/roadrunner/lib/cmake;$env{PRAENORA_RUNTIME_DEPS}/roadrunner/lib/cmake/Poco;$env{PRAENORA_RUNTIME_DEPS}/llvm;$env{PRAENORA_RUNTIME_DEPS}/antimony",
        "LLVM_INSTALL_PREFIX": "$env{PRAENORA_RUNTIME_DEPS}/llvm",
        "PRAENORA_WITH_ROADRUNNER": "ON",
        "PRAENORA_WITH_ANTIMONY": "ON",
        "PRAENORA_BUILD_PYTHON": "ON",
        "PRAENORA_WARNINGS_AS_ERRORS": "ON",
        "PRAENORA_FETCH_DEPENDENCIES": "ON",
        "CMAKE_DISABLE_FIND_PACKAGE_yaml-cpp": "ON",
        "CMAKE_DISABLE_FIND_PACKAGE_spdlog": "ON",
        "CMAKE_DISABLE_FIND_PACKAGE_googletest": "ON",
        "CMAKE_DISABLE_FIND_PACKAGE_httplib": "ON",
        "PRAENORA_THIRD_PARTY_LICENSE_DIRS": "$env{PRAENORA_RUNTIME_DEPS}/licenses"
      }
    },
    {
      "name": "ci-windows",
      "hidden": true,
      "inherits": "ci",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{PRAENORA_RUNTIME_DEPS}/json-schema-validator;$env{PRAENORA_RUNTIME_DEPS}/roadrunner;$env{PRAENORA_RUNTIME_DEPS}/roadrunner/lib/cmake;$env{PRAENORA_RUNTIME_DEPS}/roadrunner/lib/cmake/Poco;$env{PRAENORA_RUNTIME_DEPS}/roadrunner/cmake;$env{PRAENORA_RUNTIME_DEPS}/llvm;$env{PRAENORA_RUNTIME_DEPS}/antimony"
      }
    },
    {
      "name": "linux-x64-debug",
      "displayName": "Linux x86-64, Debug",
      "inherits": ["linux", "base", "debug"]
    },
    {
      "name": "linux-x64-release",
      "displayName": "Linux x86-64, Release",
      "inherits": ["linux", "base", "release"]
    },
    {
      "name": "linux-x64-asan",
      "displayName": "Linux x86-64, Debug, AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": ["linux", "base", "debug", "asan"]
    },
    {
      "name": "linux-x64-tsan",
      "displayName": "Linux x86-64, Debug, ThreadSanitizer",
      "inherits": ["linux", "base", "debug", "tsan"]
    },
    {
      "name": "macos-arm64-debug",
      "displayName": "macOS arm64, Debug",
      "inherits": ["macos", "base", "debug"],
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "macos-arm64-release",
      "displayName": "macOS arm64, Release",
      "inherits": ["macos", "base", "release"],
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "macos-arm64-asan",
      "displayName": "macOS arm64, Debug, AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": ["macos", "base", "debug", "asan"],
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "macos-arm64-tsan",
      "displayName": "macOS arm64, Debug, ThreadSanitizer",
      "inherits": ["macos", "base", "debug", "tsan"],
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x86-64, Visual Studio 2022 (build and test with Debug)",
      "inherits": ["windows", "base"]
    },
    {
      "name": "windows-x64-release",
      "displayName": "Windows x86-64, Visual Studio 2022 (build and test with Release)",
      "inherits": ["windows", "base"]
    },
    {
      "name": "ci-linux-x64-release",
      "displayName": "CI: Linux x86-64, Release, with the dependency bundle in PRAENORA_RUNTIME_DEPS",
      "inherits": ["linux-x64-release", "ci"]
    },
    {
      "name": "ci-macos-arm64-release",
      "displayName": "CI: macOS arm64, Release, with the dependency bundle in PRAENORA_RUNTIME_DEPS",
      "inherits": ["macos-arm64-release", "ci"],
      "cacheVariables": {
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0"
      }
    },
    {
      "name": "ci-windows-x64-release",
      "displayName": "CI: Windows x86-64, Visual Studio 2022, Release, with the dependency bundle in PRAENORA_RUNTIME_DEPS",
      "inherits": ["windows-x64-release", "ci-windows"],
      "cacheVariables": {
        "CMAKE_TRY_COMPILE_CONFIGURATION": "Release"
      }
    },
    {
      "name": "ci-windows-x64-debug",
      "displayName": "CI: Windows x86-64, Visual Studio 2022, Debug, with the dependency bundle in PRAENORA_RUNTIME_DEPS",
      "inherits": ["windows-x64-debug", "ci-windows"],
      "cacheVariables": {
        "CMAKE_TRY_COMPILE_CONFIGURATION": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-linux",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "build-macos",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "build-windows",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-x64-debug",
      "inherits": "build-linux",
      "configurePreset": "linux-x64-debug"
    },
    {
      "name": "linux-x64-release",
      "inherits": "build-linux",
      "configurePreset": "linux-x64-release"
    },
    {
      "name": "linux-x64-asan",
      "inherits": "build-linux",
      "configurePreset": "linux-x64-asan"
    },
    {
      "name": "linux-x64-tsan",
      "inherits": "build-linux",
      "configurePreset": "linux-x64-tsan"
    },
    {
      "name": "macos-arm64-debug",
      "inherits": "build-macos",
      "configurePreset": "macos-arm64-debug"
    },
    {
      "name": "macos-arm64-release",
      "inherits": "build-macos",
      "configurePreset": "macos-arm64-release"
    },
    {
      "name": "macos-arm64-asan",
      "inherits": "build-macos",
      "configurePreset": "macos-arm64-asan"
    },
    {
      "name": "macos-arm64-tsan",
      "inherits": "build-macos",
      "configurePreset": "macos-arm64-tsan"
    },
    {
      "name": "windows-x64-debug",
      "inherits": "build-windows",
      "configurePreset": "windows-x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-release",
      "inherits": "build-windows",
      "configurePreset": "windows-x64-release",
      "configuration": "Release"
    },
    {
      "name": "ci-linux-x64-release",
      "inherits": "linux-x64-release",
      "configurePreset": "ci-linux-x64-release"
    },
    {
      "name": "ci-macos-arm64-release",
      "inherits": "macos-arm64-release",
      "configurePreset": "ci-macos-arm64-release"
    },
    {
      "name": "ci-windows-x64-release",
      "inherits": "windows-x64-release",
      "configurePreset": "ci-windows-x64-release"
    },
    {
      "name": "ci-windows-x64-debug",
      "inherits": "windows-x64-debug",
      "configurePreset": "ci-windows-x64-debug"
    }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "environment": {
        "OTEL_SDK_DISABLED": "true"
      }
    },
    {
      "name": "test-linux",
      "hidden": true,
      "inherits": "test-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "test-macos",
      "hidden": true,
      "inherits": "test-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "test-windows",
      "hidden": true,
      "inherits": "test-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-x64-debug",
      "inherits": "test-linux",
      "configurePreset": "linux-x64-debug"
    },
    {
      "name": "linux-x64-release",
      "inherits": "test-linux",
      "configurePreset": "linux-x64-release"
    },
    {
      "name": "linux-x64-asan",
      "inherits": "test-linux",
      "configurePreset": "linux-x64-asan"
    },
    {
      "name": "linux-x64-tsan",
      "inherits": "test-linux",
      "configurePreset": "linux-x64-tsan"
    },
    {
      "name": "macos-arm64-debug",
      "inherits": "test-macos",
      "configurePreset": "macos-arm64-debug"
    },
    {
      "name": "macos-arm64-release",
      "inherits": "test-macos",
      "configurePreset": "macos-arm64-release"
    },
    {
      "name": "macos-arm64-asan",
      "inherits": "test-macos",
      "configurePreset": "macos-arm64-asan"
    },
    {
      "name": "macos-arm64-tsan",
      "inherits": "test-macos",
      "configurePreset": "macos-arm64-tsan"
    },
    {
      "name": "windows-x64-debug",
      "inherits": "test-windows",
      "configurePreset": "windows-x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-release",
      "inherits": "test-windows",
      "configurePreset": "windows-x64-release",
      "configuration": "Release"
    },
    {
      "name": "ci-linux-x64-release",
      "inherits": "linux-x64-release",
      "configurePreset": "ci-linux-x64-release",
      "environment": {
        "PRAENORA_TESTS_REQUIRE_LISTENERS": "1"
      }
    },
    {
      "name": "ci-macos-arm64-release",
      "inherits": "macos-arm64-release",
      "configurePreset": "ci-macos-arm64-release",
      "environment": {
        "PRAENORA_TESTS_REQUIRE_LISTENERS": "1"
      }
    },
    {
      "name": "ci-windows-x64-release",
      "inherits": "windows-x64-release",
      "configurePreset": "ci-windows-x64-release",
      "environment": {
        "PRAENORA_TESTS_REQUIRE_LISTENERS": "1"
      }
    },
    {
      "name": "ci-windows-x64-debug",
      "inherits": "windows-x64-debug",
      "configurePreset": "ci-windows-x64-debug",
      "environment": {
        "PRAENORA_TESTS_REQUIRE_LISTENERS": "1"
      }
    }
  ]
}
