/* The module SDK version and the protocol (PMP) version it implements.
 *
 * Generated by the build from include/praenora/sdk/version.h.in; the versions themselves are
 * defined once, in cmake/PraenoraVersions.cmake. The ABI version is in abi.h. C99 and C++. */
#ifndef PRAENORA_SDK_VERSION_H
#define PRAENORA_SDK_VERSION_H

#define PRAENORA_SDK_VERSION_MAJOR @PRAENORA_SDK_VERSION_MAJOR@
#define PRAENORA_SDK_VERSION_MINOR @PRAENORA_SDK_VERSION_MINOR@
#define PRAENORA_SDK_VERSION_PATCH @PRAENORA_SDK_VERSION_PATCH@
#define PRAENORA_SDK_VERSION_STRING "@PRAENORA_SDK_VERSION@"

#define PRAENORA_PMP_VERSION_STRING "@PRAENORA_PMP_VERSION@"

#endif /* PRAENORA_SDK_VERSION_H */
