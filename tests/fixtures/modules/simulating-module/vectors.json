            "tolerance": { "relative": 1e-12 }
          }
        }
      ]
    },
    {
      "name": "kernel-rates",
      "capability": { "id": "test.echo", "version": "0.1.0" },
      "parameters": { "kernel": true },
      "ticks": [
        {
          "inputs": {},
          "expect": {
            "outputs": {
              "out": {
                "ok": true,
                "columns": ["time", "x", "y", "total"],
                "rows": [[0, 8, 3, 11], [1, 4, 3, 7], [2, 2, 3, 5]],
