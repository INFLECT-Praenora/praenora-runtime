        },
        {
          "inputs": { "in": { "values": [0.6931471805599453, 16] } },
          "expect": {
            "outputs": {
              "out": {
                "ok": true,
                "columns": ["time", "x", "y", "total"],
                "rows": [[0, 16, 3, 19], [1, 8, 3, 11], [2, 4, 3, 7]]
              }
