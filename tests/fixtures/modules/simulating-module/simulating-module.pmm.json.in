{
  "kind": "module-manifest",
  "format_version": "@PRAENORA_MODULE_MANIFEST_FORMAT_VERSION@",
  "module": {
    "name": "@PRAENORA_MODULE_NAME@",
    "version": "@PRAENORA_MODULE_VERSION@",
    "summary": "Test fixture: runs a model through the simulation service praenora.simulation@0."
  },
  "abi": { "major": @PRAENORA_ABI_MAJOR@, "minor": @PRAENORA_ABI_MINOR@ },
  "pmp_version": "@PRAENORA_PMP_VERSION@",
  "sdk_version": "@PRAENORA_SDK_VERSION@",
  "library": { "path": "@PRAENORA_MODULE_LIBRARY_FILE@" },
  "platform": { "os": "@PRAENORA_MODULE_OS@", "arch": "@PRAENORA_MODULE_ARCH@" },
  "capabilities": @PRAENORA_MODULE_CAPABILITIES_JSON@,
  "requires": @PRAENORA_MODULE_REQUIRES_JSON@,
  "parameters_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "default": "{\"states\": {\"x\": 8, \"y\": 3}, \"parameters\": {\"k_x\": 0.6931471805599453, \"k_y\": 0}}"
      },
      "format": { "type": "string", "default": "test-decay" },
      "plan": {
        "type": "object",
        "default": {
          "parameters": ["k_x"],
          "initial_conditions": ["x"],
          "time_domain": { "start": 0, "end": 2 },
          "output": { "save_at": "explicit_times", "times": [0, 1, 2], "quantities": ["total"] }
        }
      },
      "values": {
        "type": "array",
        "items": { "type": "number" },
        "default": [0.6931471805599453, 8]
      },
      "kernel": { "type": "boolean", "default": false }
    },
    "additionalProperties": false
  },
  "tests": { "vectors": "@PRAENORA_MODULE_TEST_VECTORS@" }
}
