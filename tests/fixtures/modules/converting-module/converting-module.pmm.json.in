{
  "kind": "module-manifest",
  "format_version": "@PRAENORA_MODULE_MANIFEST_FORMAT_VERSION@",
  "module": {
    "name": "@PRAENORA_MODULE_NAME@",
    "version": "@PRAENORA_MODULE_VERSION@",
    "summary": "Test fixture: converts a model through the model conversion service praenora.model-conversion@0 and can simulate it through praenora.simulation@0."
  },
  "abi": { "major": @PRAENORA_ABI_MAJOR@, "minor": @PRAENORA_ABI_MINOR@ },
  "pmp_version": "@PRAENORA_PMP_VERSION@",
  "sdk_version": "@PRAENORA_SDK_VERSION@",
  "library": { "path": "@PRAENORA_MODULE_LIBRARY_FILE@" },
  "platform": { "os": "@PRAENORA_MODULE_OS@", "arch": "@PRAENORA_MODULE_ARCH@" },
  "capabilities": @PRAENORA_MODULE_CAPABILITIES_JSON@,
  "requires": @PRAENORA_MODULE_REQUIRES_JSON@,
  "parameters_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "default": "state x 8\nstate y 3\nparameter k_x 0.6931471805599453\nparameter k_y 0\n"
      },
      "from": { "type": "string", "default": "test-decay-text" },
      "to": { "type": "string", "default": "test-decay" },
      "module": { "type": "string" },
      "simulate": { "type": "object" },
      "convert_in": { "enum": ["initialize", "invoke"], "default": "initialize" }
    },
    "additionalProperties": false
  },
  "tests": { "vectors": "@PRAENORA_MODULE_TEST_VECTORS@" }
}
