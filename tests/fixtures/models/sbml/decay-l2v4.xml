<?xml version="1.0" encoding="UTF-8"?>
<!-- decay.xml in SBML Level 2 Version 4: dx/dt = -k_x * x and dy/dt = -k_y * y (amounts), in a
     compartment of size 2. -->
<sbml xmlns="http://www.sbml.org/sbml/level2/version4" level="2" version="4">
  <model id="decay_l2v4">
    <listOfCompartments>
      <compartment id="cell" size="2"/>
    </listOfCompartments>
    <listOfSpecies>
      <species id="x" compartment="cell" initialAmount="10" hasOnlySubstanceUnits="true"/>
      <species id="y" compartment="cell" initialAmount="4" hasOnlySubstanceUnits="true"/>
    </listOfSpecies>
    <listOfParameters>
      <parameter id="k_x" value="0.5"/>
      <parameter id="k_y" value="1.5"/>
    </listOfParameters>
    <listOfReactions>
      <reaction id="rx" reversible="false">
        <listOfReactants>
          <speciesReference species="x"/>
        </listOfReactants>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply><times/><ci>k_x</ci><ci>x</ci></apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="ry" reversible="false">
        <listOfReactants>
          <speciesReference species="y"/>
        </listOfReactants>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply><times/><ci>k_y</ci><ci>y</ci></apply>
          </math>
        </kineticLaw>
      </reaction>
    </listOfReactions>
  </model>
</sbml>
